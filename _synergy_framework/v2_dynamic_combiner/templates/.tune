## Source and Function
source: "dynamics/template.dyn"
function: "tuning/template.tune"

## Equations and Transformations
tuning_equations:
  - name: "Polarity Adjustment"
    equation: "sin(2 * pi * degree) * scale_factor + offset"
    parameters:
      scale_factor: 1.0
      offset: 0.0
    description: "Customize sinusoidal modulation for polarity attributes."

  - name: "Vibration Modulation"
    equation: "base_intensity + sin(degree + phase_shift) * intensity_range"
    parameters:
      base_intensity: 0.5
      intensity_range: 0.3
      phase_shift: 0.2
    description: "Modulate vibration levels with flexible intensity ranges and phase shifts."

  - name: "Energy Balancing"
    equation: "(creative_multiplier * creative + receptive_multiplier * receptive) / 2"
    parameters:
      creative_multiplier: 1.0
      receptive_multiplier: 1.0
    description: "Balance energy attributes dynamically using multipliers."

## Configuration Modes
modes:
  - name: "Template Default"
    description: "A generic configuration for creating custom tuning setups."
    applied_to: ["polarity", "vibration_level", "energy"]
  - name: "Custom"
    description: "Flexible mode for advanced tuning configurations."
    parameters:
      polarity.scale_factor: 1.5
      vibration_level.intensity_range: 0.4
      energy.offset: 0.2

