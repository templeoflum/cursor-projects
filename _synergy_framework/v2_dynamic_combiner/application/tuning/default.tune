## Equations and Transformations

tuning_equations:
  - name: "polarity"
    equation: "sin(2 * pi * degree) * scale_factor + offset"
    parameters:
      scale_factor: 0.5
      offset: 0.5
  - name: "vibration_level"
    equation: "base_intensity + sin(degree + phase_shift) * intensity_range"
    parameters:
      base_intensity: 0.5
      intensity_range: 0.5
      phase_shift: 0.5

modes:
  - name: "Resonant"
    description: "Enhanced modulation for harmonic resonance."
    equations: ["polarity", "vibration_level"]
    parameters:
      scale_factor: 0.1618
      intensity_range: 0.6
  - name: "Default"
    description: "Enhanced modulation for harmonic resonance."
    equations: ["vibration_level"]
    parameters:
      scale_factor: 0.05
      intensity_range: 0.1

