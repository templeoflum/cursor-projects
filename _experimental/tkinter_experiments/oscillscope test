import tkinter as tk
from tkinter import ttk
import numpy as np
import sounddevice as sd
import time
import threading

from matplotlib.figure import Figure
from matplotlib.backends.backend_tkagg import FigureCanvasTkAgg

class SineWaveApp:
    def __init__(self, master):
        self.master = master
        self.master.title("Simple Sine Wave Generator")

        # Initial parameters
        self.sampling_rate = 44100
        self.chunk_size = 1024
        self.phase = 0.0

        # Shared variables
        self.amplitude = tk.DoubleVar(value=0.5)
        self.frequency = tk.DoubleVar(value=440.0)
        self.running = False

        # Layout
        control_frame = ttk.Frame(master)
        control_frame.pack(side=tk.LEFT, fill=tk.Y, padx=10, pady=10)

        # Amplitude slider
        ttk.Label(control_frame, text="Amplitude").pack()
        amp_scale = ttk.Scale(control_frame, from_=0.0, to=1.0,
                              orient="horizontal", variable=self.amplitude)
        amp_scale.pack()

        # Frequency slider
        ttk.Label(control_frame, text="Frequency (Hz)").pack()
        freq_scale = ttk.Scale(control_frame, from_=20.0, to=2000.0,
                               orient="horizontal", variable=self.frequency)
        freq_scale.pack()

        # Start/Stop buttons
        self.start_button = ttk.Button(control_frame, text="Start", command=self.start_audio)
        self.start_button.pack(pady=5)

        self.stop_button = ttk.Button(control_frame, text="Stop", command=self.stop_audio, state=tk.DISABLED)
        self.stop_button.pack(pady=5)

        # Matplotlib Figure for oscilloscope
        self.fig = Figure(figsize=(5, 3), dpi=100)
        self.ax = self.fig.add_subplot(111)
        self.ax.set_xlim(0, self.chunk_size)
        self.ax.set_ylim(-1, 1)
        self.ax.set_xlabel("Sample Index")
        self.ax.set_ylabel("Amplitude")
        self.wave_line, = self.ax.plot([], [], lw=2)

        self.canvas = FigureCanvasTkAgg(self.fig, master=master)
        self.canvas.get_tk_widget().pack(side=tk.RIGHT, fill=tk.BOTH, expand=True)

        self.update_plot()  # Start updating the oscilloscope

    def generate_sine_wave(self, frames):
        """
        Generate a buffer of sine wave samples based on current amplitude, frequency, and phase.
        """
        t = np.arange(frames)
        # Calculate each chunk’s phase increment
        phase_increment = (2 * np.pi * self.frequency.get()) / self.sampling_rate

        # Generate the sine wave chunk
        chunk = self.amplitude.get() * np.sin(self.phase + phase_increment * t)

        # Update phase for continuity into next chunk
        self.phase += phase_increment * frames
        self.phase = self.phase % (2 * np.pi)  # keep phase in [0, 2pi)

        return chunk

    def audio_callback(self, outdata, frames, time_info, status):
        if status:
            print(status)
        samples = self.generate_sine_wave(frames)
        outdata[:] = samples.reshape(-1, 1)

    def start_audio(self):
        if not self.running:
            self.running = True
            self.stream = sd.OutputStream(samplerate=self.sampling_rate,
                                          channels=1,
                                          callback=self.audio_callback,
                                          blocksize=self.chunk_size)
            self.stream.start()
            self.start_button.config(state=tk.DISABLED)
            self.stop_button.config(state=tk.NORMAL)

    def stop_audio(self):
        if self.running:
            self.stream.stop()
            self.stream.close()
            self.running = False
            self.start_button.config(state=tk.NORMAL)
            self.stop_button.config(state=tk.DISABLED)

    def update_plot(self):
        """
        Periodically grab a short buffer of generated audio data and
        update the plot to give an oscilloscope-like effect.
        """
        if self.running:
            # Synthesize one chunk of data (without streaming it to the sound device here)
            data = self.generate_sine_wave(self.chunk_size)
            self.wave_line.set_xdata(np.arange(0, len(data)))
            self.wave_line.set_ydata(data)
        self.ax.set_xlim(0, self.chunk_size)

        self.canvas.draw()
        self.master.after(50, self.update_plot)  # schedule the next oscilloscope update

def main():
    root = tk.Tk()
    app = SineWaveApp(root)
    root.mainloop()

if __name__ == "__main__":
    main()
